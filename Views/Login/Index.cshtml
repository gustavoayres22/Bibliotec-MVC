@* O @model define qual classe sea uiliazda pela view *@
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css">
}

<header class="cabecalho">
    <a href="../home/home.html">
        <img src="~/imgs/Logo Horizontal - branca.svg" alt="Logo do sistema Bibliotec">
    </a>

    <nav class="navegacao">
        <a href="../home/home.html">Home</a>
    </nav>
</header>
<main class="conteudo">
    <section class="login">
        <div class="login-cabecalho">
            <img src="~/imgs/Icone - Bibliotec.png" alt="Logo Bibliotec">

            <h1>Bem vindo(a) à Bibliotec</h1>
            <p>Acesse sua conta para continuar</p>
        </div>

        <form asp-controller="Login" asp-action="Index" method="post">

            <div asp-validation-summary="ModeOnly" class="mensagem-erro"></div>

            <div class="campo">
                <label for="email">E-mail</label>

                @* Vincula o camo de em-mail a propriedade Email da Model *@
                <input asp-for="Email" type="email" id="email" placeholder="email@alunosenai.com">

                <span asp-validation-for="Senha" class="mensagem-erro"></span>
            </div>

            <div class="campo">
                <label for="senha">Senha</label>
                <div class="campo-senha">
                    <input asp-for="senha" required type="password" id="senha" placeholder="************">
                    <button id="mostrar-senha" class="botao-olho">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="lucide lucide-eye">
                            <path
                            d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Senha" class="mensagem-erro"></span>
            </div>

            <button type="Submit" class="botao-entrar">Entrar</button>

            <button class="botao-google">
                <img src="~/imgs/icone-google.svg" alt="Logo Google">
                <span>Continuar com Google</span>
            </button>
        </form>
    </section>
</main>

@section Scripts {
    <script src="~/js/login.js"></script>

}
